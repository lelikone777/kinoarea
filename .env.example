# Database (required for auth, profile, ratings, comments)
# Use pooled connection string for runtime queries.
DATABASE_URL=
# Use direct connection string for Prisma migrations.
DIRECT_URL=

# Auth (required in production)
AUTH_SECRET=

# TMDB (set at least one)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Stripe (optional if checkout is used)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional external translate API
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
